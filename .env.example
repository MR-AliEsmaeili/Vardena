# Local Compose overrides (placeholders only; never commit real values).
# Copy this file to .env (gitignored) before the FIRST start of a fresh
# installation and set BOOTSTRAP_SYSTEM_ADMIN_PASSWORD below — the stack
# supplies no placeholder or default password and a fresh bootstrap fails
# without it. An already-provisioned installation may skip this file and
# start with `docker-compose up`. The default stack uses passwordless trust
# authentication on the private Compose network. For password
# authentication, uncomment/set the following values together and replace
# CHANGE_ME with a real local/deployment secret.

POSTGRES_DB=vardena
POSTGRES_USER=vardena
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_PASSWORD=CHANGE_ME

# Must use the `postgres` service hostname inside the Compose network.
DATABASE_URL=postgresql://vardena:CHANGE_ME@postgres:5432/vardena

# Host port for the API. The container always listens on port 3000.
API_PORT=3000

NODE_ENV=development
APP_VERSION=0.0.0-dev
LOG_LEVEL=info
SWAGGER_ENABLED=true
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Local HTTP is used by default. Set true only when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false

# Initial password for provisioning the bootstrap system administrator (`مدیر`)
# on a fresh installation (`npm run bootstrap:system-admin` / `migrate`).
# MUST be configured (in this local, untracked `.env` file or the shell
# environment) when the bootstrap administrator does not exist yet — no
# placeholder or default password is supplied anywhere, and a fresh bootstrap
# fails with a clear error when the variable is missing (minimum 8 characters;
# never commit a real credential). Leave it empty only for an
# already-provisioned installation, where later starts do not need it. The
# provisioned account starts with `mustChangePassword=true` and must change its
# password on first login.
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=

