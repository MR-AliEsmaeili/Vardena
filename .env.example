# Optional local Compose overrides (placeholders only; never commit real values).
# A fresh clone works without copying this file:
#   docker-compose up
# The default stack uses passwordless trust authentication on the private
# Compose network. For password authentication, uncomment/set the following
# values together and replace CHANGE_ME with a real local/deployment secret.

POSTGRES_DB=vardena
POSTGRES_USER=vardena
POSTGRES_HOST_AUTH_METHOD=scram-sha-256
POSTGRES_PASSWORD=CHANGE_ME

# Must use the `postgres` service hostname inside the Compose network.
DATABASE_URL=postgresql://vardena:CHANGE_ME@postgres:5432/vardena

# Host port for the API. The container always listens on port 3000.
API_PORT=3000

NODE_ENV=development
APP_VERSION=0.0.0-dev
LOG_LEVEL=info
SWAGGER_ENABLED=true
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# Local HTTP is used by default. Set true only when serving the API over HTTPS.
AUTH_COOKIE_SECURE=false

# Initial password for provisioning the bootstrap system administrator (`مدیر`)
# on a fresh installation (`npm run bootstrap:system-admin` / `migrate`).
# Required only when the bootstrap administrator does not exist yet (minimum
# 8 characters; never commit a real credential). The provisioned account starts
# with `mustChangePassword=true` and must change its password on first login.
BOOTSTRAP_SYSTEM_ADMIN_PASSWORD=

