# Vardena compose stack — placeholders only (never commit real values).
# Copy to `.env` (repo root) and fill in, then:  docker compose up --build
# For local development outside Docker, see backend/.env.example.

POSTGRES_DB=vardena
POSTGRES_USER=vardena
# REQUIRED: local postgres password (compose fails fast when unset).
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432
API_PORT=3000

# REQUIRED: must use the `postgres` service hostname inside the compose network.
DATABASE_URL=postgresql://vardena:CHANGE_ME@postgres:5432/vardena

NODE_ENV=production
APP_VERSION=0.0.0-dev
LOG_LEVEL=info
SWAGGER_ENABLED=false
CORS_ORIGINS=
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
