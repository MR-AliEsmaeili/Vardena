{
  "name": "vardena-owner-ui",
  "version": "0.0.1",
  "description": "Independent Vardena Owner licensing UI",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run dates:verify && vitest run",
    "test:watch": "vitest",
    "dates:stage": "node scripts/stage-date-foundation.mjs",
    "predev": "npm run dates:stage",
    "prebuild": "npm run dates:stage",
    "pretypecheck": "npm run dates:stage",
    "pretest": "npm run dates:stage",
    "pretest:watch": "npm run dates:stage",
    "dates:verify": "node --test scripts/stage-date-foundation.test.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-slot": "^1.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "^8.21.3",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "jalaali-js": "^2.0.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "thinking-orbs": "^0.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^30.1.1",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
