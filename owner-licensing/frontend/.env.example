# Owner browser always uses relative same-origin URLs. Never put credentials here.
VITE_API_BASE_URL=/api/v1
# Development-only server-to-server proxy target (never a browser API URL).
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:3001
# Server-only Vite host policy (NOT VITE_* and never exposed to the browser).
# Loopback-only by default. To access from a remote browser, explicitly opt in:
# OWNER_VITE_BIND_HOST=0.0.0.0
# OWNER_VITE_ALLOWED_HOSTS=5174-your-sandbox.e2b.app,owner-dev.example
# Exact hostnames/IPs only: no scheme, port, leading dot or wildcard.
