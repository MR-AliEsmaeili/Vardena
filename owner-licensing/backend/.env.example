# Owner-only configuration. Set real values in a secret manager/untracked .env.
# OWNER_DATABASE_URL is required: a dedicated database, not the customer DB.
OWNER_DATABASE_URL=
OWNER_PUBLIC_ORIGIN=http://localhost:5174
OWNER_PORT=3001
# Absolute path on an independent volume/disk outside PostgreSQL data directory for permanent audit archive bundles (OQ-77).
OWNER_AUDIT_ARCHIVE_DIR=
NODE_ENV=development
# Required only for the explicit one-time bootstrap command. No default account secret.
OWNER_BOOTSTRAP_USERNAME=
OWNER_BOOTSTRAP_PASSWORD=
