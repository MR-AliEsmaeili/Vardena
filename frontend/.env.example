# Vardena frontend configuration (Vite). Copy to `.env.local` to override.
# Never commit real values, credentials or tokens (AG-12).

# Base URL of the Vardena API the SPA talks to (AR-19: only the Vardena API).
# Relative by default so the browser calls the same origin that serves the SPA:
#   - `npm run dev` proxies it to VITE_DEV_API_PROXY_TARGET (see vite.config.ts);
#   - in a deployment the reverse proxy in front of the static build forwards
#     `/api` to the API container.
# There is deliberately NO hard-coded production URL anywhere in the source.
VITE_API_BASE_URL=/api/v1

# Dev-server-only: where `npm run dev` proxies `/api` to. Ignored by the
# production build (`npm run build` never reads it).
VITE_DEV_API_PROXY_TARGET=http://localhost:3000
