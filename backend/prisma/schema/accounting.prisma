// Accounting module schema (docs/modules.md §Accounting, ADR-0026,
// docs/accounting/domain-contract.md).
//
// Task 10.2 — the bookkeeping scope spine:
//   `accounting.financial_areas`    — bookkeeping scopes (حوزه مالی), one
//     organization may hold n ≥ 1 (OQ-40 interim: created explicitly, never
//     seeded; no grants yet — structural scoping like `organizationId`).
//   `accounting.fiscal_years`       — explicit dated years per area with the
//     `open → closed → sealed` lifecycle (+ explicit reopen/unseal).
//   `accounting.accounting_periods` — explicit dated rows inside one year,
//     never computed months; several may be open at once.
//
// Task 10.3 — the coding structure + chart of accounts (§8/§9,
// AC-D-06…AC-D-10, AC-D-19, AC-I-10/11):
//   `accounting.coding_structure_versions` — the organization's CONFIGURABLE
//     coding structure (depth + per-level digit lengths + display-only
//     separator), versioned `draft → active → superseded` with exactly one
//     ACTIVE version per organization (§9.4). Nothing about the shape is
//     hardcoded: `2 + 3 + 3` is one configuration among many.
//   `accounting.coding_structure_levels`   — one row per level of ONE
//     VERSION: a published/superseded version is never reinterpreted by a
//     later structure change (§9.4), so levels belong to the version, not to
//     a mutable "current structure" row.
//   `accounting.accounts`                  — the whole chart of accounts in
//     ONE table: adjacency (`parent_id`) + integer `level` (AC-D-06/07).
//     There are deliberately no `groups`/`generals`/`subsidiaries`/`details`
//     tables, and `level_kind` labels are informational only (§8.1).
//
// Explicitly NOT here (later Accounting tasks — contract §28.2): control-role
// mappings, detail dimensions / groups / items (floating details), accounting
// documents + lines, posting rules, the system-posting idempotency ledger and
// balance projections.
//
// Deferred on purpose, with the seam recorded (no speculative columns —
// AR-29):
// - Area applicability of accounts (§8.3): the chart is ORGANIZATION-scoped
//   (AC-D-04), so accounts carry no `financial_area_id` and `code` is unique
//   per organization (§9.2). An applicability table has no consumer before
//   posting validation exists (§10.6/§12.5) and its shape is entangled with
//   OQ-40 (one chart vs per-area charts); if OQ-40 resolves to per-area
//   charts, uniqueness widens to `(organization_id, financial_area_id, code)`
//   as an additive change.
// - `account_type` + `is_temporary` (§8.3): the vocabulary and the
//   temporary-classification function are EXPERT-GATED (OQ-25) → no column is
//   invented. `account_nature` (`debit|credit`) IS a decided closed list and
//   is therefore stored.
// - `control_role` (§8.7) and coding-structure `reserved_ranges` (§9.1): both
//   are posting-rule inputs whose purpose vocabulary is OQ-25 → deferred with
//   the posting task that consumes them.
//
// Conventions (docs/database-strategy.md, ADR-0021):
// - every row carries `organization_id` (NOT NULL, FK RESTRICT): the
//   tenant/security boundary (AC-D-01, AC-I-01);
// - periods denormalize `organization_id` + `financial_area_id` so scope
//   checks and list indexes lead with the scope (ADR-0021 §3);
// - dates are inclusive date-only ranges (`DATE`, never timestamptz):
//   `start_date`/`end_date` with the `[start, end]` overlap test living in
//   `domain/date-range.ts` (AC-I-03);
// - statuses are closed code-defined lists stored as TEXT (`open`/`closed`/
//   `sealed`, `domain/fiscal-year.ts` / `domain/accounting-period.ts` are the
//   source of truth); no CHECK constraints — value rules are enforced and
//   unit-tested in the domain layer, because constraints Prisma cannot
//   represent would be dropped by a later `prisma migrate dev` (the same
//   reason the organization migration gives);
// - guards that must hold under concurrency (calendar overlap, "exactly one
//   active coding-structure version", account code placement, the postable-
//   leaf invariant) are enforced by short `SELECT … FOR UPDATE` transactions
//   in `data/` (docs/modules.md §Accounting, AR-11), NOT by exclusion
//   constraints or triggers: both need either a superuser extension
//   (`btree_gist`) or a PL/pgSQL function — and both are invisible to Prisma,
//   so the next generated migration would silently `DROP` them and lose the
//   invariant. Parent-row locks serialize the same writers with no drift
//   hazard; the unique indexes below stay the hard backstop for identity
//   races.
// - lifecycle: `is_active` only (OQ-36 posture); no business row is deleted.
//   The ONE exception is a coding-structure version's level rows while that
//   version is still a `draft` — an unreferenced configuration workspace,
//   deleted-and-replaced atomically (the ADR-0024 draft-configuration rule),
//   never reachable from an account. `period_kind` carries the OQ-23 seam
//   (`normal` is the only v1 value).

model FinancialArea {
  id             String  @id
  organizationId String  @map("organization_id")
  code           String  @db.VarChar(64)
  title          String  @db.VarChar(200)
  /// Per-organization default area (§5.5): at most one area per organization
  /// may hold `true`. Enforced in the application transaction
  /// (`data/financial-areas.repository.ts`) — a partial unique index would
  /// be invisible to Prisma and dropped by a later generated migration.
  isDefault      Boolean @default(false) @map("is_default")
  isActive       Boolean @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  fiscalYears  FiscalYear[]

  // Back-relations for denormalized period scope columns. Virtual side only
  // (the real FK columns stay `accounting_periods.organization_id` /
  // `.financial_area_id`) — no migration impact.
  accountingPeriods AccountingPeriod[]

  // Back-relations for the accounting documents of this area (Task 10.4):
  // the number series scope (§18) and the denormalized line scope columns.
  accountingDocuments AccountingDocument[]
  documentLines       AccountingDocumentLine[]

  @@unique([organizationId, code], map: "uq_financial_areas_organization_id_code")
  @@index([organizationId, isActive], map: "idx_financial_areas_organization_id_is_active")
  @@map("financial_areas")
  @@schema("accounting")
}

model FiscalYear {
  id              String   @id
  organizationId  String   @map("organization_id")
  financialAreaId String   @map("financial_area_id")
  code            String   @db.VarChar(64)
  title           String   @db.VarChar(200)
  /// Inclusive bounds of the year (contract §6.1). Years of one
  /// (organization, area) never overlap (AC-I-03).
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  /// `open` | `closed` | `sealed` (contract §6.3, domain/fiscal-year.ts).
  status          String   @default("open") @db.VarChar(20)
  isActive        Boolean  @default(true) @map("is_active")
  /// Optional link to the previous year of the same (organization, area) —
  /// the year-transition chain (contract §6.1). Informational only.
  priorYearId     String?  @map("prior_year_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialArea FinancialArea @relation(fields: [financialAreaId], references: [id], onDelete: Restrict)
  priorYear    FiscalYear?  @relation("FiscalYearChain", fields: [priorYearId], references: [id], onDelete: Restrict)
  followingYears FiscalYear[] @relation("FiscalYearChain")
  accountingPeriods AccountingPeriod[]

  // Back-relations for the documents/lines that pin this year (Task 10.4,
  // contract §12.2: the resolved year is stored, never recomputed).
  accountingDocuments AccountingDocument[]
  documentLines       AccountingDocumentLine[]

  @@unique([organizationId, financialAreaId, code], map: "uq_fiscal_years_organization_id_financial_area_id_code")
  @@index([organizationId, financialAreaId], map: "idx_fiscal_years_organization_id_financial_area_id")
  @@index([organizationId, financialAreaId, status], map: "idx_fiscal_years_organization_id_financial_area_id_status")
  @@index([priorYearId], map: "idx_fiscal_years_prior_year_id")
  @@map("fiscal_years")
  @@schema("accounting")
}

model AccountingPeriod {
  id              String   @id
  organizationId  String   @map("organization_id")
  financialAreaId String   @map("financial_area_id")
  fiscalYearId    String   @map("fiscal_year_id")
  /// 1-based ordinal inside the year; unique per year (contract §7.1).
  sequence        Int
  title           String   @db.VarChar(200)
  /// Inclusive bounds; always inside the year's range (AC-I-03).
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  /// `open` | `closed` | `sealed` (contract §7.2, domain/accounting-period.ts).
  status          String   @default("open") @db.VarChar(20)
  /// v1 vocabulary: `normal` only. An adjustment/special period is an
  /// EXPERT-GATED addition (OQ-23) — the seam exists, the value does not.
  periodKind      String   @default("normal") @map("period_kind") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy       String?  @map("created_by")
  updatedBy       String?  @map("updated_by")

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialArea FinancialArea  @relation(fields: [financialAreaId], references: [id], onDelete: Restrict)
  fiscalYear    FiscalYear     @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)

  // Back-relations for the documents/lines resolved into this period
  // (Task 10.4 — the stored period resolution, AC-I-14).
  accountingDocuments AccountingDocument[]
  documentLines       AccountingDocumentLine[]

  @@unique([fiscalYearId, sequence], map: "uq_accounting_periods_fiscal_year_id_sequence")
  @@index([organizationId, fiscalYearId], map: "idx_accounting_periods_organization_id_fiscal_year_id")
  @@index([organizationId, fiscalYearId, status], map: "idx_accounting_periods_organization_id_fiscal_year_id_status")
  @@map("accounting_periods")
  @@schema("accounting")
}

// ---------------------------------------------------------------------------
// Coding structure + chart of accounts (Task 10.3, contract §8/§9)
// ---------------------------------------------------------------------------

/// One revision of an organization's coding structure (§9.1, AC-D-10).
///
/// `code` names the structure inside the organization (`DEFAULT`, `SIMPLE`, …)
/// and `versionNumber` counts its revisions — the shape the Workflow
/// Foundation established for versioned configuration (ADR-0024 §3, which
/// §9.4 names explicitly): `draft → active → superseded`, one-way.
///
/// Exactly ONE version per organization is `active` (§9.4): it is the
/// structure NEW root accounts are created under, and publishing a version
/// supersedes the previous active one. Enforced inside a locked transaction
/// (`data/coding-structures.repository.ts`) rather than by a partial unique
/// index — a partial index is invisible to Prisma and would be dropped by the
/// next generated migration (the same reason this file gives for `is_default`
/// on `financial_areas`).
///
/// `maxDepth` + `separator` + the level rows below ARE the structure: no
/// segment count, digit length or separator is hardcoded anywhere in the
/// module (`2 + 3 + 3` is one configuration among many).
model CodingStructureVersion {
  id             String  @id
  organizationId String  @map("organization_id")
  /// Structure identity inside the organization; versions of one structure
  /// share it. Unique per (organization, code, versionNumber).
  code           String  @db.VarChar(64)
  /// 1-based ordinal per (organization, code), assigned at creation.
  versionNumber  Int     @map("version_number")
  /// `draft` | `active` | `superseded` (domain/coding-structure.ts).
  status         String  @default("draft") @db.VarChar(16)
  /// Number of levels: 1..MAX_CODING_STRUCTURE_DEPTH (architecture cap = 8).
  maxDepth       Int     @map("max_depth")
  /// DISPLAY ONLY (§9.1/§9.2): how a code is rendered (`-`, `/`, `.` or
  /// empty = none). Never part of a stored code, never part of uniqueness.
  separator      String  @default("") @db.VarChar(1)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  levels       CodingStructureLevel[]
  accounts     Account[]

  /// Two concurrent "create the next version" writes collide HERE (the loser
  /// retries with the recomputed ordinal — the Workflow version precedent).
  @@unique([organizationId, code, versionNumber], map: "uq_coding_structure_versions_org_id_code_version_number")
  /// "the organization's active version" — the resolver every new root
  /// account and every picker needs; leads with the scope column (ADR-0021 §3).
  @@index([organizationId, status], map: "idx_coding_structure_versions_organization_id_status")
  @@index([organizationId, code], map: "idx_coding_structure_versions_organization_id_code")
  @@map("coding_structure_versions")
  @@schema("accounting")
}

/// One level of one coding-structure version (§9.1).
///
/// Levels belong to the VERSION (not to a mutable "current structure" row) so
/// that a later structure change never reinterprets the codes accounts pinned
/// to this version already carry (§9.4).
model CodingStructureLevel {
  id             String  @id
  organizationId String  @map("organization_id")
  versionId      String  @map("coding_structure_version_id")
  /// 1-based ordinal inside the version; every level 1..maxDepth must exist
  /// before the version can become active (domain/coding-structure.ts).
  levelIndex     Int     @map("level_index")
  /// The level title the organization sees (§8.1: level titles are
  /// organization configuration — `گروه / کل / معین / تفصیلی` are the common
  /// Iranian vocabulary, not a code constant).
  title          String  @db.VarChar(200)
  /// Digits this level's segment contributes. ≥ 1, and the total across the
  /// version is capped (MAX_ACCOUNT_CODE_LENGTH = 32) — architecture
  /// constants that bound validation and index widths (§9.1), not policy.
  digitLength    Int     @map("digit_length")
  /// Per-level default for new accounts (§14 rule 4). A DEFAULT, not a rule:
  /// `is_postable` is an account attribute the chart may override.
  defaultIsPostable Boolean @default(false) @map("default_is_postable")
  /// Informational label only (`group` | `general` | `subsidiary` | `detail`).
  /// NOTHING derives behaviour from it (§8.1: the semantic hooks live on the
  /// account, not on a level name), which is why duplicates across levels are
  /// allowed and the list may be shorter than `maxDepth`.
  levelKind      String?  @map("level_kind") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  version      CodingStructureVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)

  @@unique([versionId, levelIndex], map: "uq_coding_structure_levels_version_id_level_index")
  @@index([organizationId, versionId], map: "idx_coding_structure_levels_organization_id_version_id")
  @@map("coding_structure_levels")
  @@schema("accounting")
}

/// One node of the organization's chart of accounts (§8, AC-D-06…AC-D-08).
///
/// ONE table for the whole tree (AC-D-07): `parent_id` + `level` is the
/// authority, the code prefix is the proof (§9.3). No `path` projection yet
/// (§8.2 allows one as a rebuildable projection — it belongs with the
/// reporting task that reads it).
///
/// Immutability: `code` is immutable once created (§8.3) — there is no code
/// field on the update path at all, and nothing reuses a code (§8.6). The
/// structural fields (`parent_id`, `level`, `account_nature`, `is_postable`)
/// are immutable once the account has document lines (AC-I-11, §8.4 rule 4);
/// document lines are Task 10.4+, so the domain rule is implemented behind the
/// single documented seam in `domain/account.ts` (`isReferencedByDocumentLine`)
/// — there is NO fake usage table (Task 10.3 §16 forbids inventing one).
model Account {
  id             String  @id
  organizationId String  @map("organization_id")
  /// Canonical code: digits only, the concatenation of the level segments
  /// (§9.2). Unique per ORGANIZATION because the chart is organization-scoped
  /// (AC-D-04, §9.2). Width = MAX_ACCOUNT_CODE_LENGTH (the §9.1 cap), so the
  /// length rule can never be expressed only in the domain layer.
  code           String  @db.VarChar(32)
  /// Persian-capable title (§2.3 C4); editable (titles change, codes do not).
  title          String  @db.VarChar(200)
  /// `null` for roots. ON DELETE RESTRICT: nothing is deleted, and the tree
  /// can never lose an ancestor under a report's feet (§8.6, AR-13).
  parentId       String? @map("parent_id")
  /// 1-based depth, ALWAYS derived: root = 1, child = parent.level + 1
  /// (AC-I-10 rule 1). Never supplied by a client.
  level          Int
  /// The structure version this account's code was composed under (§9.4,
  /// D-21, AC-I-14) — historical codes stay interpretable without the
  /// CURRENT structure. Derived: roots take the org's active version, children
  /// inherit the parent's, so one subtree never mixes two versions.
  codingStructureVersionId String @map("coding_structure_version_id")
  /// Balance direction (`ماهیت`), `debit` | `credit` (§8.3). Reporting
  /// semantics only — it does NOT restrict which side a future line uses
  /// (§13.4).
  accountNature  String   @map("account_nature") @db.VarChar(8)
  /// §14 (`AC-D-19`): a validated attribute, not a level-name inference.
  /// Invariant: postable ⇒ leaf, enforced on BOTH write paths (see
  /// `AccountsRepository`).
  isPostable     Boolean  @default(false) @map("is_postable")
  /// `false` blocks new posting lines and new children, and changes nothing
  /// else: history stays readable (§8.6).
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       Account?               @relation("AccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children     Account[]              @relation("AccountTree")
  codingStructureVersion CodingStructureVersion @relation(fields: [codingStructureVersionId], references: [id], onDelete: Restrict)
  /// The document lines that reference this account (Task 10.4). The real FK is
  /// `accounting_document_lines.account_id` (RESTRICT); this is the virtual side.
  documentLines AccountingDocumentLine[]

  /// The canonical-code uniqueness (§9.2) — the authoritative duplicate guard
  /// for concurrent creates (the service pre-check only produces a nicer 409).
  @@unique([organizationId, code], map: "uq_accounts_organization_id_code")
  /// Children of one node (the `hasChildren` guard, the tree walk, the
  /// direct-children list) — leads with the scope column (ADR-0021 §3).
  @@index([organizationId, parentId], map: "idx_accounts_organization_id_parent_id")
  @@index([organizationId, level], map: "idx_accounts_organization_id_level")
  @@index([organizationId, isActive], map: "idx_accounts_organization_id_is_active")
  /// "which accounts pin this version" — the query a structure-version
  /// retirement and (later) a structure migration must answer.
  @@index([codingStructureVersionId], map: "idx_accounts_coding_structure_version_id")
  @@map("accounts")
  @@schema("accounting")
}

// ---------------------------------------------------------------------------
// Accounting documents (Task 10.4, contract §12…§18, AC-D-16…AC-D-23)
// ---------------------------------------------------------------------------

/// The accounting document (voucher, `سند حسابداری`) HEADER — Accounting's own
/// aggregate, NOT a universal document table (AC-D-16, contract §12.1).
///
/// `document_type` is the Document Foundation type code this row was composed
/// under (`accounting_voucher` in v1; the year-transition types of §6.4 are
/// planned, code-registered additions). It is stored so that a number's series,
/// a lifecycle decision and an audit trail stay self-describing — it is NOT a
/// client-inventable value: the type catalogue is code (`DocumentTypeRegistry`,
/// ADR-0023 §2), so the column can only ever repeat a registered code.
///
/// State/phase: `state ∈ {draft, temporary, final}` where `draft` is the
/// Foundation's PHASE (pre-issuance), not a third state (AC-D-20). `final` is
/// structurally immutable — there is no update path in the service and no
/// repository method that would let a caller reach around it (AC-I-05/06).
///
/// Ordering/identity: `document_number` is the numeric-only serial allocated by
/// the Document Foundation at issuance (§18, AC-D-29) and is NULL while the
/// document is still a draft. The number's uniqueness scope is the financial
/// area (`uq_accounting_documents_org_area_number`), matching "one monotonic
/// series per (organization, type, area)" — PostgreSQL treats NULLs as
/// distinct, so any number of draft rows may share the NULL number.
///
/// `idempotency_reference`/`request_hash` are the SYSTEM-origin evidence
/// (§12.2/§16.4): the posting-operation key that produced this document and the
/// sha256 of that operation's canonical client intent. The ledger row itself
/// lives in `accounting_posting_operations`; these two columns are the
/// document-side reference the contract asks for. Manual documents leave them
/// NULL — their evidence is `finalized_at`/`finalized_by` plus the operation
/// ledger row keyed by the caller's `operationKey`.
///
/// Deferred by the contract, so NOT columns here (AR-29): the correction links
/// and `correction_kind`/`correction_reason` (§15.4, AC-D-22 — the correction
/// task), currency/exchange rate (§24.1, OQ-03), attachments (§12.6) and the
/// quantity/statistical column (§12.6).
model AccountingDocument {
  id                 String   @id
  organizationId     String   @map("organization_id")
  financialAreaId    String   @map("financial_area_id")
  /// Resolved from `document_date` at composition and re-validated at
  /// finalization (contract §6.2 rule 4, AC-I-14): reports never recompute a
  /// period from a date.
  fiscalYearId       String   @map("fiscal_year_id")
  accountingPeriodId String   @map("accounting_period_id")
  /// Registered Document Foundation type code (ADR-0023 §2).
  documentType       String   @default("accounting_voucher") @map("document_type") @db.VarChar(64)
  /// Numeric-only serial, NULL until issuance; immutable once the document is
  /// `final` (§15.2, AC-I-22).
  documentNumber     String?  @map("document_number") @db.VarChar(32)
  /// Business/occurrence date, date-only (`DATE`) — drives period resolution
  /// and chronological reporting (contract §12.3). Never a timestamp.
  documentDate       DateTime @map("document_date") @db.Date
  /// Header narration; required and non-blank (contract §12.2).
  description        String   @db.VarChar(500)
  /// `draft` | `temporary` | `final` (domain/accounting-document.ts, AC-D-20).
  state              String   @default("draft") @db.VarChar(16)
  /// `manual` | `system` (contract §16.1, AC-D-24). Closed, code-defined list.
  origin             String   @db.VarChar(16)
  /// Optional operational scope dimension, header-level only (AC-D-17).
  branchId           String?  @map("branch_id")
  /// System-origin source identity (§16.3): module, entity type, entity id and
  /// the operation that produced the posting — logical references, never FKs
  /// (there is no universal document table, AR-07/08).
  sourceModule       String?  @map("source_module") @db.VarChar(64)
  sourceEntityType   String?  @map("source_entity_type") @db.VarChar(64)
  sourceEntityId     String?  @map("source_entity_id")
  sourceOperation    String?  @map("source_operation") @db.VarChar(32)
  /// System-origin idempotency evidence (§16.4) — the ledger key + intent hash.
  idempotencyReference String? @map("idempotency_reference") @db.VarChar(128)
  requestHash        String?  @map("request_hash") @db.Char(64)
  /// Finalization evidence (§15.5, §23).
  finalizedAt        DateTime? @map("finalized_at") @db.Timestamptz(6)
  finalizedBy        String?   @map("finalized_by")
  /// End-to-end traceability (docs/architecture.md §9): the request that
  /// created the document.
  correlationId      String?  @map("correlation_id") @db.VarChar(64)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by")
  updatedBy          String?  @map("updated_by")

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialArea    FinancialArea    @relation(fields: [financialAreaId], references: [id], onDelete: Restrict)
  fiscalYear       FiscalYear       @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  branch           Branch?          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  lines            AccountingDocumentLine[]

  /// The number's uniqueness scope: the financial area (§18 — one series per
  /// (organization, type, area)); the `documents.numbering_allocations` ledger
  /// stays the authoritative allocator, this index is the accounting-side
  /// backstop that makes a duplicate number impossible to persist.
  @@unique([organizationId, financialAreaId, documentNumber], map: "uq_accounting_documents_org_area_number")
  @@index([organizationId, state], map: "idx_accounting_documents_organization_id_state")
  @@index([organizationId, financialAreaId, documentDate], map: "idx_accounting_documents_org_area_date")
  @@index([organizationId, accountingPeriodId], map: "idx_accounting_documents_org_period")
  @@map("accounting_documents")
  @@schema("accounting")
}

/// One line of an accounting document (contract §12.5, AC-I-07/08).
///
/// Lines are part of the aggregate: they are created/replaced only while the
/// document is editable, in the SAME transaction as the header, and are never
/// touched once it is `final` (AC-I-05/06). The scope columns are the
/// header's, denormalized for indexed period/account reads (ADR-0021 §3); the
/// write path derives all four from ONE resolved context, so they cannot drift.
///
/// `debit_amount`/`credit_amount` are `numeric(18,2)` (AR-12): non-negative
/// exact decimals, exactly one non-zero per line (§13.2, AC-I-08). Money is
/// carried as decimal STRINGS through the domain (module convention) and never
/// compared as a float, and the Σ debit = Σ credit check is exact — no epsilon,
/// no rounding to force balance (§13.1, AC-I-07).
///
/// `source_line_reference` is the optional logical line reference for system
/// origin (§12.5, §20.3): an opaque `(module, entity, line)` token, never an FK.
model AccountingDocumentLine {
  id                 String   @id
  documentId         String   @map("document_id")
  organizationId     String   @map("organization_id")
  financialAreaId    String   @map("financial_area_id")
  fiscalYearId       String   @map("fiscal_year_id")
  accountingPeriodId String   @map("accounting_period_id")
  /// 1-based, unique per document and DENSE (no gaps) — the legal-book
  /// rendering order (§12.5).
  lineNo             Int      @map("line_no")
  accountId          String   @map("account_id")
  debitAmount        Decimal  @default(0) @map("debit_amount") @db.Decimal(18, 2)
  creditAmount       Decimal  @default(0) @map("credit_amount") @db.Decimal(18, 2)
  description        String?  @db.VarChar(500)
  sourceLineReference String? @map("source_line_reference") @db.VarChar(128)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy          String?  @map("created_by")
  updatedBy          String?  @map("updated_by")

  /// CASCADE: a line has no existence outside its document, and deleting a
  /// pre-final voucher (§15.3, AC-D-21) removes its aggregate parts in one
  /// statement. `final` is never deletable, so no history row can be lost.
  document       AccountingDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialArea  FinancialArea      @relation(fields: [financialAreaId], references: [id], onDelete: Restrict)
  fiscalYear     FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod  @relation(fields: [accountingPeriodId], references: [id], onDelete: Restrict)
  /// RESTRICT: an account with lines can never disappear (nothing is deleted,
  /// and §8.6 freezes an account that has been used).
  account        Account            @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([documentId, lineNo], map: "uq_accounting_document_lines_document_id_line_no")
  @@index([organizationId, accountId], map: "idx_accounting_document_lines_org_account")
  @@map("accounting_document_lines")
  @@schema("accounting")
}

/// The Accounting-owned posting-operation ledger (contract §16.4, AC-I-12).
///
/// One row per completed posting operation, unique on
/// `(organization_id, operation_key)`; written INSIDE the transaction that
/// performs the effect (inserted last, like `inventory_operations`), so a
/// committed effect always has its key and a failed one never does. Same key +
/// same `request_hash` replays the stored result; the same key with a different
/// hash is refused with 409 and nothing is applied.
///
/// `request_hash` is sha256 over the CANONICAL CLIENT INTENT only: no generated
/// ids, no server clocks, an omitted optional value hashed as an explicit
/// `null` (ADR-0022 §4 — the rule that makes a retry hash identically instead
/// of falsely conflicting).
///
/// `operation` is a closed, code-defined list (`document_create`,
/// `document_finalize` — `domain/accounting-document.ts`). The contract's list
/// is explicitly illustrative (`§16.4` "e.g."); only the kinds this task
/// actually performs are declared, and no kind is written that the code does
/// not enforce (docs/security.md §3 posture).
///
/// The ledger is append-only and never deleted, so a pre-final voucher that is
/// discarded (§15.3) leaves its operation rows behind: the audit trail is
/// complete, and a replayed key whose document is gone answers 404 rather than
/// re-creating it (§15.3 + append-only ledger).
model AccountingPostingOperation {
  id             String   @id
  organizationId String   @map("organization_id")
  /// Caller-supplied idempotency key (opaque, at most 128 chars).
  operationKey   String   @map("operation_key") @db.VarChar(128)
  /// Closed, code-defined list of implemented posting operations.
  operation      String   @db.VarChar(32)
  /// sha256 hex over the canonical client intent.
  requestHash    String   @map("request_hash") @db.Char(64)
  /// Created-row ids, e.g. `{ "documentId": "…" }`. Opaque to the database (no
  /// query pattern reads inside it) — the same envelope convention as
  /// `inventory_operations.result`.
  result         Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, operationKey], map: "uq_accounting_posting_operations_org_key")
  @@index([organizationId, operation], map: "idx_accounting_posting_operations_org_operation")
  @@map("accounting_posting_operations")
  @@schema("accounting")
}
