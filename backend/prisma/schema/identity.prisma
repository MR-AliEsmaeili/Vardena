// Identity module schema (docs/modules.md §Identity, ADR-0007).
//
// Owns: `identity.sessions` — server-side opaque sessions.
// Only the SHA-256 hash of the token is stored; the raw token travels
// via httpOnly cookie (never persisted in plaintext).

model Session {
  id                 String    @id
  userId             String    @map("user_id")
  tokenHash          String    @unique(name: "uq_sessions_token_hash") @map("token_hash")
  userAgent          String?   @map("user_agent")
  ipAddress          String?   @map("ip_address")
  createdAt          DateTime  @timestamptz() @map("created_at")
  lastSeenAt         DateTime  @timestamptz() @map("last_seen_at")
  expiresAt          DateTime  @timestamptz() @map("expires_at")
  absoluteExpiresAt  DateTime  @timestamptz() @map("absolute_expires_at")
  revokedAt          DateTime? @timestamptz() @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt], name: "idx_sessions_user_id_revoked_at")
  @@index([expiresAt], name: "idx_sessions_expires_at")
  @@map("sessions")
  @@schema("identity")
}
