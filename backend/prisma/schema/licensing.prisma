// Licensing owns commercial Customer/Installation/License/LicenseVersion
// facts. Organization remains a business tenant inside the single deployed
// installation.
//
// L-03 (ADR-0046): a License is the installation-bound commercial right; every
// signed version it has ever received is a retained LicenseVersion row. The
// effective version is resolved deterministically at read time (never
// materialized, never rewritten), so a future-dated renewal can coexist with a
// license that is still valid without either replacing the other.

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED

  @@schema("licensing")
}

enum LicenseType {
  COMMERCIAL
  DEVELOPER

  @@schema("licensing")
}

enum EntitlementKind {
  MODULE
  FEATURE

  @@schema("licensing")
}

enum ClientDeviceStatus {
  ACTIVE
  DEACTIVATED
  REPLACED

  @@schema("licensing")
}

enum DeviceEnrollmentState {
  PENDING
  CONSUMED
  EXPIRED

  @@schema("licensing")
}

enum DeviceReplacementState {
  CHALLENGE
  PENDING
  COMPLETED
  CANCELLED
  EXPIRED

  @@schema("licensing")
}

model LicenseCustomer {
  id           String   @id
  customerCode String   @unique(map: "uq_customers_customer_code") @map("customer_code") @db.VarChar(64)
  displayName  String   @map("display_name") @db.VarChar(200)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy    String?  @map("created_by")
  updatedBy    String?  @map("updated_by")

  installations Installation[]
  licenses      License[]

  @@map("customers")
  @@schema("licensing")
}

model Installation {
  id         String   @id
  customerId String?  @map("customer_id")
  name       String   @db.VarChar(200)
  /// Exactly one row may be the identity of THIS deployment (L-02).
  isSelf     Boolean  @default(false) @map("is_self")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  customer          LicenseCustomer?                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  licenses          License[]
  auditEvents       LicenseAuditEvent[]
  clientDevices     ClientDevice[]
  deviceChallenges  DeviceEnrollmentChallenge[]
  deviceReplacements ClientDeviceReplacementRequest[]

  @@index([customerId], map: "idx_installations_customer_id")
  @@map("installations")
  @@schema("licensing")
}

/// Stable signed-license identity and holder binding for one installation.
/// COMMERCIAL rows bind a customer; DEVELOPER rows bind an explicit
/// non-commercial developer. Dates, limits and entitlements belong to retained
/// versions. License-level commercial revocation state is retained here.
model License {
  id             String      @id
  installationId String      @map("installation_id")
  licenseType    LicenseType @default(COMMERCIAL) @map("license_type")
  /// Commercial holder; null for an official non-commercial Developer License.
  customerId     String?     @map("customer_id")
  /// Explicit Developer holder identity; null for commercial licenses.
  developerId    String?     @map("developer_id") @db.VarChar(64)
  developerName  String?     @map("developer_name") @db.VarChar(200)
  /// OD-LIC-17 revocation state. Set together with `revocation_id`, never
  /// cleared: a revoked license is final and is never approximated by a status
  /// or a date. Guarded by `licenses_revocation_state_check`;
  /// `license_revocations.license_id` is the authoritative record.
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationId   String?   @map("revocation_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy      String?  @map("created_by")
  updatedBy      String?  @map("updated_by")

  installation Installation       @relation(fields: [installationId], references: [id], onDelete: Restrict)
  customer     LicenseCustomer?   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  versions     LicenseVersion[]
  revocation   LicenseRevocation?

  /// Composite target so a version cannot name a license of another
  /// installation (integrity, not convention).
  @@unique([id, installationId], map: "uq_licenses_id_installation")
  @@index([installationId], map: "idx_licenses_installation_id")
  @@index([licenseType, developerId], map: "idx_licenses_type_developer_id")
  @@map("licenses")
  @@schema("licensing")
}

/// One signed, retained LicenseVersion. Immutable except for supersession.
model LicenseVersion {
  id             String @id
  licenseId      String @map("license_id")
  installationId String @map("installation_id")
  /// Unique operation identity (replay protection, PDR-11 §10.7/§12.4).
  operationId String @map("operation_id")
  status      LicenseStatus
  provider    String @db.VarChar(80)
  /// Payload/document version of the artifact this version was imported from
  /// (1 = legacy code, 2 = signed document).
  documentVersion Int @map("document_version")
  /// SHA-256 of the verified artifact. The artifact itself is NEVER persisted.
  documentHash String @map("document_hash")
  /// Trusted key id that verified the signature (null for legacy rows).
  keyId  String? @map("key_id") @db.VarChar(120)
  source String  @db.VarChar(20)
  validFrom DateTime  @map("valid_from") @db.Timestamptz(6)
  /// The signed `issuedAt` of the artifact this version came from, retained as
  /// a typed fact so a later revocation can be refused when it predates the
  /// version it targets (protocol §4 step 10, `stale-revocation`). NULL only on
  /// legacy `VLIC1` rows and on rows imported before this column existed; the
  /// staleness comparison is then documented as not assessable, never guessed
  /// from `imported_at` or `valid_from`.
  signedIssuedAt DateTime? @map("signed_issued_at") @db.Timestamptz(6)
  /// Instant from which this version starts governing when it differs from the
  /// signed valid_from (a renewal: the renewed term boundary). NULL = signed
  /// valid_from, which is the value of every row written before OD-LIC-06.
  /// Guarded by license_versions_governs_from_check: a deferred start requires
  /// a supersession link and must precede valid_until.
  governsFrom DateTime? @map("governs_from") @db.Timestamptz(6)
  /// Exclusive end. null means perpetual.
  validUntil DateTime? @map("valid_until") @db.Timestamptz(6)
  organizationLimit Int? @map("organization_limit")
  userLimit         Int? @map("user_limit")
  /// Null is unlimited only when deviceLimitSpecified is true.
  deviceLimit Int? @map("device_limit")
  /// False for pre-OQ-83 signed artifacts whose canonical payload omitted the field.
  deviceLimitSpecified Boolean @default(false) @map("device_limit_specified")
  importedAt DateTime @map("imported_at") @db.Timestamptz(6)
  importedBy String?  @map("imported_by")
  /// Explicit signed supersession (the only way windows may overlap), or the
  /// version a legacy text code replaced.
  supersedesVersionId String? @map("supersedes_version_id")
  /// WHEN the supersession was recorded (the successor's import instant).
  /// Audit/traceability only — it never decides eligibility.
  supersededAt DateTime? @map("superseded_at") @db.Timestamptz(6)
  /// The instant FROM which this version no longer governs: the retiring
  /// successor's `valid_from`, so a future-dated renewal does not interrupt a
  /// license that is still valid (PDR-11 §3.2, CF-1). The import refuses a
  /// hand-over that would remove governance this version already exercised
  /// before the import instant (`backdated-supersession`, OQ-86) — a rule in
  /// `evaluateImportConflicts`, deliberately NOT a database constraint. Set
  /// together with `superseded_at`; both null while never retired.
  governsUntil DateTime? @map("governs_until") @db.Timestamptz(6)
  supersededByVersionId String?   @map("superseded_by_version_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  /// Composite target so a version cannot name a license of another
  /// installation (integrity, not convention).
  license License @relation(fields: [licenseId, installationId], references: [id, installationId], onDelete: Restrict)

  supersedesVersion    LicenseVersion?  @relation("LicenseVersionSupersedes", fields: [supersedesVersionId], references: [id], onDelete: Restrict)
  supersededVersions   LicenseVersion[] @relation("LicenseVersionSupersedes")
  supersededByVersion  LicenseVersion?  @relation("LicenseVersionSupersededBy", fields: [supersededByVersionId], references: [id], onDelete: Restrict)
  supersededByVersions LicenseVersion[] @relation("LicenseVersionSupersededBy")

  entitlements LicenseVersionEntitlement[]

  @@unique([installationId, operationId], map: "uq_license_versions_installation_operation")
  @@unique([installationId, documentHash], map: "uq_license_versions_installation_document")
  @@index([installationId, supersededAt], map: "idx_license_versions_installation_superseded")
  @@index([installationId, validFrom], map: "idx_license_versions_installation_valid_from")
  @@index([licenseId], map: "idx_license_versions_license_id")
  @@map("license_versions")
  @@schema("licensing")
}

model LicenseVersionEntitlement {
  id        String          @id
  versionId String          @map("version_id")
  kind      EntitlementKind
  code      String          @db.VarChar(120)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy String?         @map("created_by")
  updatedBy String?         @map("updated_by")

  version LicenseVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, kind, code], map: "uq_license_version_entitlements_version_kind_code")
  @@index([kind, code], map: "idx_license_version_entitlements_kind_code")
  @@map("license_version_entitlements")
  @@schema("licensing")
}

/// Typed, append-only licensing audit trail (PDR-11 §12.7). It stores
/// identifiers, outcomes and a document hash — never a raw document, signature
/// or key. Retention policy is open (OQ-77); nothing deletes rows.
model LicenseAuditEvent {
  id             String   @id
  installationId String   @map("installation_id")
  /// e.g. `license.import.applied` / `license.import.rejected`.
  eventType      String   @map("event_type") @db.VarChar(60)
  /// APPLIED | REJECTED | UNCHANGED
  outcome     String   @db.VarChar(20)
  /// Recorded only when the signature verified (never trusted otherwise).
  operationId String?  @map("operation_id")
  licenseId   String?  @map("license_id")
  versionId   String?  @map("version_id")
  /// Device context for OQ-83 events; never a private key or raw document.
  deviceId              String? @map("device_id")
  replacementRequestId  String? @map("replacement_request_id")
  actorId               String? @map("actor_id")
  source                String  @db.VarChar(20)
  documentHash          String? @map("document_hash")
  /// Bounded, machine-readable rejection reason (never a stack trace).
  reason String? @db.VarChar(60)
  /// Human-readable audit detail. Successful events retain the full reason and required context.
  detail String? @db.Text
  /// The commercial customer the installation was bound to BEFORE an explicit
  /// transfer; null on every other event (Q4, 2026-10-12).
  previousCustomerId String? @map("previous_customer_id")
  /// The business customer code BEFORE that transfer (L-06, PDR-14); null on every other event.
  previousCustomerCode String? @map("previous_customer_code") @db.VarChar(64)
  /// The customer it is bound to AFTER that transfer; null on every other event.
  newCustomerId String? @map("new_customer_id")
  /// The business customer code AFTER that transfer (L-06, PDR-14); null on every other event.
  newCustomerCode String? @map("new_customer_code") @db.VarChar(64)
  /// The license governing immediately before the event it is recorded on:
  /// - `license.import.recovered` — the license whose lapsed coverage a
  ///   dedicated post-gap recovery follows (OQ-87 Option B, PDR-13);
  /// - `license.installation.customer-transferred` — the license that governed
  ///   this installation immediately before an explicit customer transfer took
  ///   effect, observed under the installation transaction lock (L-06, PDR-14
  ///   §3.5.4; the NEW license identity is the event's own `licenseId`).
  /// Null on every other event, and null on a transfer whose installation had
  /// no governing license then. A prior/current license pair is the traceable
  /// history the Owner decisions require — and neither a recovery nor a
  /// transfer re-binds a license identity, so this is context, not a foreign
  /// key: a license id is retained forever, even if its rows were ever removed.
  previousLicenseId String?  @map("previous_license_id")
  /// The retained version a renewal extended (OD-LIC-06 / OQ-88). Set only on
  /// `license.import.renewed`; the signed `renewsOperationId` itself is not
  /// persisted separately — the chain edge is `supersedes_version_id` and
  /// `governs_from IS NOT NULL` is the renewal discriminator.
  renewedVersionId String? @map("renewed_version_id")
  /// The instant the renewal starts governing (the renewed version's end).
  renewedFrom DateTime? @map("renewed_from") @db.Timestamptz(6)
  /// The Owner-signed new end date the renewal applies, exactly as signed.
  renewedUntil DateTime? @map("renewed_until") @db.Timestamptz(6)
  /// The signed revocation identity (OD-LIC-17) on `license.revocation.imported`
  /// and `license.revocation.rejected`; null on every other event. Context, not
  /// a foreign key — an audit row outlives any table's constraints.
  revocationId String? @map("revocation_id")
  occurredAt DateTime @map("occurred_at") @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy  String?  @map("created_by")
  updatedBy  String?  @map("updated_by")

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)

  @@index([installationId, occurredAt], map: "idx_license_audit_events_installation_occurred_at")
  @@index([eventType], map: "idx_license_audit_events_event_type")
  @@index([installationId, deviceId, occurredAt], map: "idx_license_audit_events_installation_device_occurred_at")
  @@index([installationId, replacementRequestId, occurredAt], map: "idx_license_audit_events_installation_replacement_occurred_at")
  @@map("license_audit_events")
  @@schema("licensing")
}

/// One verified, imported signed revocation (OD-LIC-17;
/// docs/licensing/revocation-artifact-protocol.md §8).
///
/// Append-only: rows are never updated or deleted, and a license is revoked at
/// most once (`uq_license_revocations_license`). The artifact itself is NOT
/// stored — only its SHA-256 and the canonical payload's SHA-256, exactly like
/// `license_versions.document_hash`. Revoking rewrites no version and deletes
/// nothing: the retained signed history stays intact and the license-level
/// state decides entitlement.
model LicenseRevocation {
  /// The signed ULID identity of the revocation act (replay/idempotency key).
  revocationId String @id @map("revocation_id")
  /// One revocation per license, forever.
  licenseId           String    @unique(map: "uq_license_revocations_license") @map("license_id")
  installationId      String    @map("installation_id")
  customerId          String    @map("customer_id")
  customerCode        String    @map("customer_code") @db.VarChar(64)
  /// The retained version's operation id that existed when the revocation was
  /// authorized — signed evidence, never a filter (protocol §5).
  targetOperationId   String    @map("target_operation_id")
  reason              String    @db.VarChar(40)
  reasonDetail        String?   @db.VarChar(500) @map("reason_detail")
  /// The trust-list id of the key that verified the signature.
  issuerKeyId         String    @map("issuer_key_id") @db.VarChar(120)
  issuedAt            DateTime  @map("issued_at") @db.Timestamptz(6)
  importedAt          DateTime  @map("imported_at") @db.Timestamptz(6)
  importedBy          String?   @map("imported_by")
  /// SHA-256 of the exact armored artifact received (never the artifact).
  artifactSha256      String    @map("artifact_sha256") @db.VarChar(64)
  /// SHA-256 of the canonical signed payload bytes.
  canonicalPayloadSha256 String @map("canonical_payload_sha256") @db.VarChar(64)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")

  /// The database enforces the stronger composite foreign key
  /// `(license_id, installation_id) -> licenses (id, installation_id)`, so a
  /// revocation can never target a license of another installation. Prisma
  /// declares the 1:1 on the unique `license_id` column because a 1:1 relation
  /// may only reference a unique field set; the navigation property is unused
  /// by every code path (`revocationId` is the identity actually read).
  license License @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@index([installationId, importedAt], map: "idx_license_revocations_installation_imported_at")
  @@index([customerId], map: "idx_license_revocations_customer")
  @@map("license_revocations")
  @@schema("licensing")
}

/// One cryptographic client device registered against a server installation.
/// Only the public key is persisted; the non-extractable private key stays on
/// the client device. Rows are retained after deactivation or replacement.
model ClientDevice {
  id                   String            @id
  installationId       String            @map("installation_id")
  operationId          String            @map("operation_id")
  keyFingerprint       String            @map("key_fingerprint") @db.VarChar(64)
  publicKey            String            @map("public_key") @db.Text
  status               ClientDeviceStatus
  activatedAt          DateTime          @map("activated_at") @db.Timestamptz(6)
  deactivatedAt        DateTime?         @map("deactivated_at") @db.Timestamptz(6)
  deactivatedBy        String?           @map("deactivated_by")
  replacedAt           DateTime?         @map("replaced_at") @db.Timestamptz(6)
  replacedByDeviceId   String?           @map("replaced_by_device_id")
  enrollmentChallengeId String?          @map("enrollment_challenge_id")
  replacementRequestId String?           @map("replacement_request_id")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy            String?           @map("created_by")
  updatedBy            String?           @map("updated_by")

  installation       Installation                    @relation(fields: [installationId], references: [id], onDelete: Restrict)
  replacedBy         ClientDevice?                   @relation("ClientDeviceReplacement", fields: [replacedByDeviceId, installationId], references: [id, installationId], onDelete: Restrict)
  replaces           ClientDevice[]                  @relation("ClientDeviceReplacement")
  enrollmentChallenge DeviceEnrollmentChallenge?    @relation(fields: [enrollmentChallengeId, installationId], references: [id, installationId], onDelete: Restrict)
  replacementRequest ClientDeviceReplacementRequest? @relation("ReplacementActivation", fields: [replacementRequestId, installationId], references: [id, installationId], onDelete: Restrict)
  pendingReplacements ClientDeviceReplacementRequest[] @relation("ReplacementOldDevice")

  @@unique([id, installationId], map: "uq_client_devices_id_installation")
  @@unique([installationId, operationId], map: "uq_client_devices_installation_operation")
  @@unique([installationId, keyFingerprint], map: "uq_client_devices_installation_fingerprint")
  @@unique([installationId, replacedByDeviceId], map: "uq_client_devices_installation_replaced_by")
  @@unique([installationId, enrollmentChallengeId], map: "uq_client_devices_installation_enrollment_challenge")
  @@unique([installationId, replacementRequestId], map: "uq_client_devices_installation_replacement_request")
  // Prisma requires a unique constraint on the exact ordered relation scalar fields.
  @@unique([enrollmentChallengeId, installationId], map: "uq_client_devices_enrollment_challenge_installation")
  @@unique([replacementRequestId, installationId], map: "uq_client_devices_replacement_request_installation")
  @@index([installationId, status, activatedAt], map: "idx_client_devices_installation_status_activated_at")
  @@map("client_devices")
  @@schema("licensing")
}

/// A one-use, server-issued challenge for ordinary direct device enrollment.
model DeviceEnrollmentChallenge {
  id              String                @id
  installationId  String                @map("installation_id")
  operationId     String                @map("operation_id")
  deviceId        String                @map("device_id")
  keyFingerprint  String                @map("key_fingerprint") @db.VarChar(64)
  publicKey       String                @map("public_key") @db.Text
  customerId      String                @map("customer_id")
  customerCode    String                @map("customer_code") @db.VarChar(64)
  licenseId       String                @map("license_id")
  licenseVersionId String               @map("license_version_id")
  canonicalPayload String               @map("canonical_payload") @db.Text
  issuedAt        DateTime              @map("issued_at") @db.Timestamptz(6)
  expiresAt       DateTime              @map("expires_at") @db.Timestamptz(6)
  state           DeviceEnrollmentState
  consumedAt      DateTime?             @map("consumed_at") @db.Timestamptz(6)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy       String?               @map("created_by")

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  device        ClientDevice?

  @@unique([id, installationId], map: "uq_device_enrollment_challenges_id_installation")
  @@unique([installationId, operationId], map: "uq_device_enrollment_challenges_installation_operation")
  @@index([installationId, state, expiresAt], map: "idx_device_enrollment_challenges_installation_state_expires")
  @@map("device_enrollment_challenges")
  @@schema("licensing")
}

/// Durable signed exchange for replacing one device without access to its old
/// private key. CHALLENGE rows are not valid pending replacements until the
/// new device proves possession of its own key.
model ClientDeviceReplacementRequest {
  id                    String                  @id
  installationId        String                  @map("installation_id")
  challengeId           String                  @map("challenge_id")
  operationId           String                  @map("operation_id")
  oldDeviceId           String                  @map("old_device_id")
  newDeviceId           String                  @map("new_device_id")
  keyFingerprint        String                  @map("key_fingerprint") @db.VarChar(64)
  publicKey             String                  @map("public_key") @db.Text
  nonce                 String                  @db.VarChar(128)
  canonicalPayload      String                  @map("canonical_payload") @db.Text
  requestSignature      String?                 @map("request_signature") @db.Text
  requestHash           String?                 @map("request_hash") @db.VarChar(64)
  customerId            String                  @map("customer_id")
  customerCode          String                  @map("customer_code") @db.VarChar(64)
  licenseId             String                  @map("license_id")
  licenseVersionId      String                  @map("license_version_id")
  issuedAt              DateTime                @map("issued_at") @db.Timestamptz(6)
  challengeExpiresAt    DateTime                @map("challenge_expires_at") @db.Timestamptz(6)
  requestExpiresAt      DateTime                @map("request_expires_at") @db.Timestamptz(6)
  state                 DeviceReplacementState
  responseOperationId   String?                 @map("response_operation_id")
  responseHash          String?                 @map("response_hash") @db.VarChar(64)
  responseKeyId         String?                 @map("response_key_id") @db.VarChar(120)
  completedAt           DateTime?               @map("completed_at") @db.Timestamptz(6)
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  expiredAt             DateTime?               @map("expired_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdBy             String?                 @map("created_by")
  updatedBy             String?                 @map("updated_by")

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Restrict)
  oldDevice    ClientDevice @relation("ReplacementOldDevice", fields: [oldDeviceId, installationId], references: [id, installationId], onDelete: Restrict)
  activatedDevice ClientDevice? @relation("ReplacementActivation")

  @@unique([id, installationId], map: "uq_device_replacement_requests_id_installation")
  @@unique([installationId, challengeId], map: "uq_device_replacement_requests_installation_challenge")
  @@unique([installationId, operationId], map: "uq_device_replacement_requests_installation_operation")
  @@unique([installationId, responseOperationId], map: "uq_device_replacement_requests_installation_response_operation")
  @@index([installationId, oldDeviceId, state], map: "idx_device_replacement_requests_installation_old_state")
  @@index([installationId, state, requestExpiresAt], map: "idx_device_replacement_requests_installation_state_expires")
  @@map("client_device_replacement_requests")
  @@schema("licensing")
}
