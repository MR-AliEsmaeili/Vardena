# Vardena backend — example environment (placeholders only, never real secrets).
# Copy to `.env` and fill in per deployment. See README.md "Configuration".
#
# Every key is validated at startup; the process exits with a clear error
# when a value is missing or invalid (kernel/config/app-config.ts).

# one of: development | test | production (default: development)
NODE_ENV=development

# HTTP port for the API process (default: 3000)
PORT=3000

# REQUIRED. PostgreSQL connection string used by the API, the worker,
# and the Prisma CLI (migrations). Credentials come from the deployment,
# never from the repo (AR-20, AG-12).
DATABASE_URL=postgresql://vardena:CHANGE_ME@localhost:5432/vardena

# Optional build/release label exposed by /api/v1/health/live (default: 0.0.0-dev)
APP_VERSION=0.0.0-dev

# one of: debug | info | warn | error
# (default: debug in development, info otherwise)
LOG_LEVEL=info

# Enable Swagger UI at /api/docs (default: true except in production)
SWAGGER_ENABLED=true

# Comma-separated list of allowed browser origins for CORS.
# Empty = same-origin only (most restrictive, recommended).
# Example for local SPA development: http://localhost:5173
CORS_ORIGINS=

# Set to true when running behind a trusted reverse proxy so request IPs
# are read from X-Forwarded-For (default: false)
TRUST_PROXY=false

# Global per-IP rate limit window and budget (security.md section 5).
# Defaults: 300 requests per 60s window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300

# ---- Deployment shape (ADR-0025) ----
# Optional. When set to a valid organization ULID, the deployment is confined
# to that one organization: every request naming another organization id
# answers 404, the organizations list returns only the pinned row, and
# creating further organizations through the API is rejected (422).
# Leave unset for the default multi-organization structural scoping
# (ADR-0021): organizationId stays a caller-supplied parameter.
# When set, `npm run bootstrap:system-admin` also provisions that exact
# organization row (if missing) and the bootstrap administrator's ordinary
# membership of it, so a fresh installation needs no manual SQL.
# DEPLOYMENT_ORGANIZATION_ID=01ORGANIZATIONA000000000AA

# ---- Licensing (ADR-0030) ----
# Provider selection is explicit; it is never inferred from NODE_ENV or admin identity.
LICENSE_PROVIDER=local-development
LICENSE_STATUS=ACTIVE
LICENSE_VALID_FROM=2020-01-01T00:00:00.000Z
# ISO-8601 date-time, or "perpetual" (null validity end; no magic date).
LICENSE_VALID_UNTIL=perpetual
# Positive integer, or "unlimited" (null; no magic number).
LICENSE_ORGANIZATION_LIMIT=unlimited
LICENSE_USER_LIMIT=unlimited
# Only implemented module prefixes should be listed.
LICENSE_MODULE_ENTITLEMENTS=organization,users,rbac,inventory,documents,workflow,accounting
LICENSE_FEATURE_ENTITLEMENTS=

# ---- Authentication / session configuration (security.md §2, ADR-0007, OQ-06) ----
# All values have safe defaults matching the documented security baseline.

# Name of the httpOnly session cookie.
AUTH_COOKIE_NAME=vardena_session
# Cookie Path (default: /).
AUTH_COOKIE_PATH=/
# Cookie SameSite (lax|strict|none). Default: lax (ADR-0007).
AUTH_COOKIE_SAME_SITE=lax
# Cookie Secure flag. Default: true in production, false otherwise.
# Set explicitly only if you need to deviate (e.g. HTTPS on a dev proxy).
# AUTH_COOKIE_SECURE=false

# Sliding idle session timeout in milliseconds (default: 30 minutes).
AUTH_SESSION_IDLE_TIMEOUT_MS=1800000
# Absolute session timeout in milliseconds (default: 12 hours — hard cap).
AUTH_SESSION_ABSOLUTE_TIMEOUT_MS=43200000

# Stricter rate limit for the login endpoint (security.md §5).
# Default: 10 attempts per 15 minutes per IP.
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
